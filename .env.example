NODE_ENV=development
PORT=3000
HOST=0.0.0.0
NODE_VERSION=24.19.0

# Render persistent disk paths. Local development can leave these blank.
SFPS_DATA_DIR=
SFPS_UPLOAD_DIR=

# Gemini-only YT AI. Keep the real key out of Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional deterministic owner passwords. Never commit real values.
SFPS_OWNER_PASSWORD=
SFPS_DIRECTOR_PASSWORD=

# Required in production. Use a random 32+ character value.
SFPS_SESSION_SECRET=
